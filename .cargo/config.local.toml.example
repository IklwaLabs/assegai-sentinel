# Machine-specific development overrides.
#
# Copy this file to `config.local.toml` and edit it. Cargo loads both, with the local one
# taking precedence, and `config.local.toml` is git-ignored so a personal path never reaches
# the repository.
#
# Why this exists: Npcap's runtime installs `wpcap.dll` into System32 but not the import
# library `wpcap.lib`, so a machine with Npcap installed and without the SDK cannot link.
# Point `IKLWA_PCAP_LIB` at a directory containing `wpcap.lib` — the Npcap SDK's `Lib`
# directory, or the output of `tools/make-wpcap-lib.ps1`.
#
# If you installed the Npcap SDK properly you do not need this file at all: the build script
# finds `wpcap.lib` in the standard SDK locations on its own.

[env]
# IKLWA_PCAP_LIB = { value = "C:\\path\\to\\Npcap\\Lib" }