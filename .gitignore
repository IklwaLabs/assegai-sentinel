# Rust
/target
**/*.rs.bk
*.pdb
*.ilk

# Per-machine cargo state. `.cargo/config.toml` is committed because it holds no
# machine-specific paths; anything that does belongs in the `IKLWA_PCAP_LIB` environment
# variable instead, which is why nothing here needs ignoring.

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Tauri build output
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Local runtime state (never commit user data or databases)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/data/
/logs/

# Local configuration and secrets
.env
.env.local
*.local.toml

# Generated reports / exports
/reports/
/exports/
*.pdf

# Golden PCAP fixtures are committed deliberately; everything else is not
*.pcapng.tmp

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini